<section aria-labelledby="demo-title">
    <h2 id="demo-title">Élevages de démonstration</h2>
    <p>Toutes les données sont fictives. Les règles simplifiées ne remplacent pas le jugement clinique.</p>
    <p>Ce socle présente le jeu de données ; les parcours de visite restent à implémenter.</p>

    <ul class="list-group">
        @foreach (var location in Data.Locations)
        {
            <li class="list-group-item" @key="location.Id">
                <strong>@location.Name</strong>
                <span> — @location.City — @location.AnimalCount vaches</span>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public DemoDataSet Data { get; set; } = default!;
}
